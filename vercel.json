{
  "installCommand": "npm --prefix packages/tilawa-core install && npm --prefix packages/tilawa-core run build && npm --prefix web/frontend install",
  "buildCommand": "npm --prefix web/frontend run build && npm --prefix web/frontend run assets:v1 -- --models-url \"https://github.com/yazinsai/tilawa/releases/download/models-v1/{id}-{version}.onnx\"",
  "outputDirectory": "web/frontend/dist",
  "headers": [
    {
      "source": "/v1/runtime/ort/(.*\\.mjs)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/v1/runtime/ort/(.*\\.wasm)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ]
}
